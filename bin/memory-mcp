#!/bin/bash
# memory-mcp launcher.
# Resolves the install location and runs the MCP server with node.
# Set MEMORY_HOME to override the wiki path.

set -e

if [ -n "$MEMORY_HOME_ROOT" ]; then
  ROOT="$MEMORY_HOME_ROOT"
else
  SOURCE="${BASH_SOURCE[0]}"
  while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
  done
  ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
fi

SERVER="$ROOT/mcp/server.js"
if [ ! -f "$SERVER" ]; then
  echo "memory-mcp: cannot find $SERVER. Run install.sh." >&2
  exit 1
fi

exec node "$SERVER" "$@"
