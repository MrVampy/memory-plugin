#!/usr/bin/env bash
# memory CLI launcher.
#
# Finds its own install location by following symlinks, then runs the
# compiled Gleam JS bundle from there.
#
# Note: MEMORY_HOME is the wiki directory (used by the `memory validate`
# command to locate the wiki), NOT the launcher's install location. The
# launcher's location is always resolved via symlink walk — do not
# conflate the two.

set -e

# Follow symlinks to find the real script location.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

ENTRY="$ROOT/build/dev/javascript/memory/gleam@@private_main_v1.15.2.mjs"

if [ ! -f "$ENTRY" ]; then
  echo "memory: cannot find compiled JS bundle at $ENTRY" >&2
  echo "memory: run install.sh to build the project" >&2
  exit 1
fi

exec node "$ENTRY" "$@"
